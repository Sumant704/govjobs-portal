# ---------------------------------------------------------------------------
# Astro frontend environment
# Copy to `.env` and fill in.  Nothing here is a secret except the webhook key.
# ---------------------------------------------------------------------------

# Public canonical origin (used for sitemap, hreflang, OG tags)
SITE_URL=https://example-govjobs.com

# --- WordPress connection -------------------------------------------------
# Base URL of the WordPress install (no trailing slash)
WP_API_URL=https://admin.example-govjobs.com

# "rest"  -> /wp-json/wp/v2/   (default, works with ACF to REST API)
# "graphql" -> /graphql        (needs WPGraphQL + WPGraphQL for ACF)
WP_API_MODE=rest

# Application password for authenticated requests (draft previews, private posts).
# Create in wp-admin -> Users -> Profile -> Application Passwords.
# Leave blank for a fully public read-only frontend.
WP_APP_USER=
WP_APP_PASSWORD=

# How long (seconds) a WordPress API response is cached in memory before re-fetch.
# 60-120s keeps the WP server safe during result-day traffic spikes.
WP_CACHE_TTL=90

# Set to "false" to make the site fail loudly when WordPress is unreachable.
# In production keep "true": the portal serves a bundled content snapshot
# instead of a 500 error page if wp-admin is down.
WP_FALLBACK_TO_SNAPSHOT=true

# --- On-demand revalidation ----------------------------------------------
# Shared secret. The WordPress webhook must send this as `x-revalidate-secret`.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# --- Ads (Google AdSense) -------------------------------------------------
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_ENABLED=true

# --- Analytics ------------------------------------------------------------
PUBLIC_GA_MEASUREMENT_ID=
