---
import Icon from '@/components/Icon.astro';
import SearchBox from '@/components/SearchBox.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import AdSlot from '@/components/AdSlot.astro';
import CategoryTiles from '@/components/CategoryTiles.astro';
import type { Lang, Paginated, PostSummary, PostTypeKey } from '@/lib/types';
import { POST_TYPES, categoryPath } from '@/lib/post-types';
import { useTranslations, localizePath } from '@/i18n/utils';

interface Props {
  lang: Lang;
  query: string;
  results: Paginated<PostSummary>;
  counts: Partial<Record<PostTypeKey, number>>;
}
const { lang, query, results, counts } = Astro.props;
const t = useTranslations(lang);

const searchPath = localizePath('/search', lang);
const hasQuery = query.trim().length >= 2;

/** Group hits by post type so a broad query is still scannable. */
const grouped = new Map<PostTypeKey, PostSummary[]>();
for (const item of results.items) {
  const list = grouped.get(item.type) ?? [];
  list.push(item);
  grouped.set(item.type, list);
}
---

<header class="border-b border-line bg-surface-2">
  <div class="container-page py-6 sm:py-8">
    <Breadcrumbs lang={lang} items={[{ label: t('searchTitle') }]} />
    <h1 class="mt-4 text-2xl font-extrabold tracking-tight sm:text-3xl">{t('searchTitle')}</h1>
    <div class="mt-4 max-w-2xl">
      <SearchBox lang={lang} value={query} size="lg" autofocus={!hasQuery} />
    </div>
    {hasQuery && (
      <p class="mt-3 text-sm text-ink-2">
        {t('searchResultsFor')} <strong class="text-ink">“{query}”</strong>
        {' · '}
        <span class="text-ink-3">{results.total} {t('searchCount')}</span>
      </p>
    )}
  </div>
</header>

<div class="container-page pt-8">
  {/* The empty state doubles as navigation, so a visitor who landed here by
      mistake is not stuck. */}
  {!hasQuery ? (
    <div class="space-y-8">
      <div class="card grid place-items-center px-6 py-12 text-center">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-soft text-brand">
          <Icon name="search" size={26} />
        </span>
        <p class="mt-4 text-base font-bold">{t('searchHint')}</p>
        <p class="mt-1.5 max-w-md text-sm text-ink-2">{t('searchNoResultsHint')}</p>
      </div>
      <CategoryTiles lang={lang} counts={counts} />
    </div>
  ) : results.items.length === 0 ? (
    <div class="space-y-8">
      <div class="card grid place-items-center px-6 py-14 text-center">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-surface-2 text-ink-3">
          <Icon name="search" size={26} />
        </span>
        <p class="mt-4 text-base font-bold">{t('searchNoResults')}</p>
        <p class="mt-1.5 max-w-md text-sm text-ink-2">{t('searchNoResultsHint')}</p>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
          {(['jobs', 'results', 'admit-card'] as PostTypeKey[]).map((key) => (
            <a href={categoryPath(key, lang)} class="btn btn-ghost text-xs">
              <Icon name={POST_TYPES[key].icon as any} size={15} />
              {POST_TYPES[key].label[lang]}
            </a>
          ))}
        </div>
      </div>
      <CategoryTiles lang={lang} counts={counts} />
    </div>
  ) : (
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        {[...grouped.entries()].map(([typeKey, items]) => (
          <section class="mb-8 reveal">
            <div class="section-head mb-3">
              <h2 class="flex items-center gap-2.5 text-base font-bold">
                <span
                  class="grid h-7 w-7 place-items-center rounded-lg"
                  style={`background:var(--${POST_TYPES[typeKey].accent}-soft); color:var(--${POST_TYPES[typeKey].accent});`}
                >
                  <Icon name={POST_TYPES[typeKey].icon as any} size={15} />
                </span>
                {POST_TYPES[typeKey].label[lang]}
                <span class="text-xs font-normal text-ink-3">({items.length} {items.length === 1 ? t('postSingular') : t('posts')})</span>
              </h2>
              <a href={categoryPath(typeKey, lang)} class="text-[11px] font-semibold text-brand hover:underline">
                {t('viewAll')}
              </a>
            </div>
            <div class="card px-4 py-1">
              {items.map((post) => (
                <PostCard post={post} lang={lang} variant="row" showType={false} headingLevel={2} />
              ))}
            </div>
          </section>
        ))}

        <Pagination
          lang={lang}
          page={results.page}
          totalPages={results.totalPages}
          basePath={searchPath}
          query={`q=${encodeURIComponent(query)}`}
        />
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <AdSlot slot="search-sidebar" format="halfpage" label={t('adLabel')} />
        <nav class="card p-4">
          <h2 class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-wider">
            <Icon name="layers" size={14} class="text-brand" />
            {t('footerCategories')}
          </h2>
          <ul class="space-y-1">
            {(Object.keys(POST_TYPES) as PostTypeKey[]).map((key) => (
              <li>
                <a
                  href={categoryPath(key, lang)}
                  class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm font-medium text-ink-2 transition-colors hover:bg-surface-2 hover:text-brand"
                >
                  <span
                    class="grid h-6 w-6 place-items-center rounded-md"
                    style={`background:var(--${POST_TYPES[key].accent}-soft); color:var(--${POST_TYPES[key].accent});`}
                  >
                    <Icon name={POST_TYPES[key].icon as any} size={13} />
                  </span>
                  {POST_TYPES[key].short[lang]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    </div>
  )}
</div>
