---
import Icon from '@/components/Icon.astro';
import type { Lang } from '@/lib/types';
import { useTranslations, localizePath, stripLangPrefix } from '@/i18n/utils';

interface Props {
  lang: Lang;
  /** Canonical (English) path, e.g. "/results/ssc-cgl-2026". */
  currentPath: string;
  variant?: 'compact' | 'text';
}
const { lang, currentPath, variant = 'compact' } = Astro.props;
const t = useTranslations(lang);

const target: Lang = lang === 'en' ? 'hi' : 'en';
// stripLangPrefix guards against being handed an already-prefixed path.
const href = localizePath(stripLangPrefix(currentPath), target);
---

<a
  href={href}
  hreflang={target === 'hi' ? 'hi-IN' : 'en-IN'}
  class:list={[
    'group inline-flex items-center justify-center gap-1.5 rounded-lg font-semibold transition-colors',
    variant === 'compact'
      ? 'h-9 min-w-9 px-2 text-xs text-ink-2 hover:bg-surface-2 hover:text-brand'
      : 'px-2 py-1 text-ink-3 hover:text-brand',
  ]}
  aria-label={t('langSwitchLabel')}
  title={t('langSwitchLabel')}
>
  <Icon name="globe" size={variant === 'compact' ? 16 : 13} />
  <span>{t('langSwitchTo')}</span>
</a>
