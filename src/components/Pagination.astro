---
import Icon from '@/components/Icon.astro';
import type { Lang } from '@/lib/types';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  page: number;
  totalPages: number;
  /** Canonical path without page number, e.g. "/results" or "/search?q=ssc". */
  basePath: string;
  /** Query string to preserve, without leading "?". */
  query?: string;
}

const { lang, page, totalPages, basePath, query = '' } = Astro.props;
const t = useTranslations(lang);

const hrefFor = (p: number) => {
  const params = new URLSearchParams(query);
  if (p > 1) params.set('page', String(p));
  else params.delete('page');
  const qs = params.toString();
  return qs ? `${basePath}?${qs}` : basePath;
};

/**
 * Windowed pagination: always show first/last, plus a ±1 window around the
 * current page. Without windowing, a 200-page archive renders 200 links.
 */
const window = 1;
const pages: (number | 'gap')[] = [];
for (let p = 1; p <= totalPages; p++) {
  if (p === 1 || p === totalPages || (p >= page - window && p <= page + window)) {
    pages.push(p);
  } else if (pages[pages.length - 1] !== 'gap') {
    pages.push('gap');
  }
}
---

{totalPages > 1 && (
  <nav class="no-print mt-8 flex items-center justify-center gap-1.5" aria-label={t('paginationPage')}>
    {page > 1 ? (
      <a href={hrefFor(page - 1)} class="btn btn-ghost px-3 py-2 text-xs" rel="prev">
        <Icon name="chevronLeft" size={15} />
        <span class="hidden sm:inline">{t('paginationPrev')}</span>
      </a>
    ) : (
      <span class="btn btn-ghost cursor-not-allowed px-3 py-2 text-xs opacity-45">
        <Icon name="chevronLeft" size={15} />
        <span class="hidden sm:inline">{t('paginationPrev')}</span>
      </span>
    )}

    <div class="flex items-center gap-1">
      {pages.map((p) =>
        p === 'gap' ? (
          <span class="px-1.5 text-xs text-ink-3">…</span>
        ) : p === page ? (
          <span
            class="grid h-9 min-w-9 place-items-center rounded-lg bg-brand px-2 text-xs font-bold text-brand-ink"
            aria-current="page"
          >
            {p}
          </span>
        ) : (
          <a
            href={hrefFor(p)}
            class="grid h-9 min-w-9 place-items-center rounded-lg border border-line bg-surface px-2 text-xs font-semibold text-ink-2 transition-colors hover:border-brand hover:text-brand"
          >
            {p}
          </a>
        ),
      )}
    </div>

    {page < totalPages ? (
      <a href={hrefFor(page + 1)} class="btn btn-ghost px-3 py-2 text-xs" rel="next">
        <span class="hidden sm:inline">{t('paginationNext')}</span>
        <Icon name="chevronRight" size={15} />
      </a>
    ) : (
      <span class="btn btn-ghost cursor-not-allowed px-3 py-2 text-xs opacity-45">
        <span class="hidden sm:inline">{t('paginationNext')}</span>
        <Icon name="chevronRight" size={15} />
      </span>
    )}
  </nav>
)}
