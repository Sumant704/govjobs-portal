export type IconName = keyof typeof PATHS;

interface Props {
  name: IconName;
  class?: string;
  size?: number | string;
  strokeWidth?: number;
  hidden?: boolean;
}

const { name, class: className = '', size = 20, strokeWidth = 1.9, hidden = true } = Astro.props;

const path = PATHS[name] ?? PATHS.file;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={hidden}
  focusable="false"
  set:html={path}
/>
